{
  "name": "@openvtt/dice-notation",
  "version": "0.1.0",
  "description": "Canonical OpenVTT dice notation — unambiguous parse/fromFormula and toFormula for the dice IR, the best of Foundry and Roll20 without their collisions.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openvtt/dice-core": "workspace:*",
    "@openvtt/formula": "workspace:*",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["openvtt", "dice", "notation", "parser", "foundry", "roll20", "vtt"]
}
