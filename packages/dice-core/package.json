{
  "name": "@openvtt/dice-core",
  "version": "0.1.0",
  "description": "Canonical dice IR + seeded evaluator for OpenVTT — Valibot-validated, dialect-neutral, side-effect-free except for an injectable RNG.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openvtt/formula": "workspace:*",
    "seedrandom": "^3.0.5",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/seedrandom": "^3.0.8",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["openvtt", "dice", "vtt", "foundry", "roll20", "seedrandom", "ir"]
}
