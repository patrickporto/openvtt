{
  "name": "@openvtt/sheet",
  "version": "0.1.0",
  "description": "Effect-oriented character sheet engine for OpenVTT — the document is minimal, the effect pipeline is the heart: collect, filter, sort by UUID v7, apply, derive, emit.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openvtt/dice-core": "workspace:*",
    "@openvtt/dice-notation": "workspace:*",
    "@openvtt/events": "workspace:*",
    "@openvtt/formula": "workspace:*",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["openvtt", "sheet", "effects", "active-effects", "vtt", "rpg", "foundry"]
}
