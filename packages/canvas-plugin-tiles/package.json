{
  "name": "@openvtt/canvas-plugin-tiles",
  "version": "0.1.0",
  "description": "Tile document plugin for @openvtt/canvas — Tile placeable and drag-to-place tile tool.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openvtt/canvas": "workspace:*",
    "valibot": "^1.4.2"
  },
  "peerDependencies": {
    "pixi.js": "^8.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pixi.js": "^8.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["openvtt", "canvas", "plugin", "tile", "vtt", "tabletop"]
}
