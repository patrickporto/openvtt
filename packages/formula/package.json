{
  "name": "@openvtt/formula",
  "version": "0.1.0",
  "description": "Tiny, jsep-powered formula IR for OpenVTT — json-logic-shaped AST that travels over the event bus, persists to documents, and runs with no eval.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jsep": "^1.4.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["openvtt", "formula", "jsep", "json-logic", "vtt", "ast", "ir"]
}
