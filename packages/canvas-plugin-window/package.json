{
  "name": "@openvtt/canvas-plugin-window",
  "version": "0.1.0",
  "description": "Window manager for @openvtt/canvas — floating, modal, dockable, snappable windows with taskbar and state persistence.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openvtt/canvas": "workspace:*",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/node": "^22.10.0",
    "happy-dom": "^20.11.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["openvtt", "canvas", "plugin", "window", "window-manager", "dock", "modal", "vtt", "tabletop"]
}
